class First extends Thread
{
    public void run()
    {
        for(int i = 1; i <= 10; i++)
        {
            System.out.println("First: " + i);

            if(i == 2)
            {
                Thread.yield();
            }
        }
    }
}

class Second extends Thread
{
    public void run()
    {
        for(int i = 10; i >= 1; i--)
        {
            System.out.println("Second: " + i);
        }
    }
}

class Test
{
    public static void main(String[] args)
    {
        First t1 = new First();
        Second t2 = new Second();

        t1.start();
        t2.start();
    }
}
