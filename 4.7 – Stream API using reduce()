// Unit 4.7 - Stream API using Reduce

import java.util.Arrays;
import java.util.List;

public class Main
{
    public static void main(String[] args)
    {
        List<Integer> list = Arrays.asList(10, 20, 30, 40);

        int sum = list.stream()
                      .reduce(0, (a, b) -> a + b);

        System.out.println("Sum: " + sum);
    }
}
