// Experiment 7.2 - Multithreading: Print Odd and Even Numbers

public class Main
{
    public static void main(String[] args)
    {
        Thread t1 = new Thread(() ->
        {
            for(int i = 1; i <= 20; i++)
            {
                if(i % 2 != 0)
                    System.out.println("Odd: " + i);
            }
        });

        Thread t2 = new Thread(() ->
        {
            for(int i = 1; i <= 20; i++)
            {
                if(i % 2 == 0)
                    System.out.println("Even: " + i);
            }
        });

        t1.start();
        t2.start();
    }
}
