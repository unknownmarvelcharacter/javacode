// LCA 6.1 - Demonstrate Super Keyword

class Parent
{
    Parent()
    {
        System.out.println("Parent Constructor");
    }
}

class Child extends Parent
{
    Child()
    {
        super();
        System.out.println("Child Constructor");
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Child c = new Child();
    }
}
