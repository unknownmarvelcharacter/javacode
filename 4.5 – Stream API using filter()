// Unit 4.5 - Stream API using Filter

import java.util.Arrays;
import java.util.List;

public class Main
{
    public static void main(String[] args)
    {
        List<Integer> list = Arrays.asList(10, 15, 20, 25, 30);

        list.stream()
            .filter(n -> n > 20)
            .forEach(n -> System.out.println(n));
    }
}
