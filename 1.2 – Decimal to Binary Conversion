// Unit 1.2 - Decimal to Binary Conversion

public class Main
{
    public static void main(String[] args)
    {
        int n = 10;
        int binary = 0;
        int place = 1;

        while(n > 0)
        {
            int r = n % 2;
            binary = binary + r * place;
            place = place * 10;
            n = n / 2;
        }

        System.out.println("Binary: " + binary);
    }
}
