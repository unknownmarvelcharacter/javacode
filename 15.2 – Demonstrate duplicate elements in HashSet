// Experiment 15.2 - Set Interface: Duplicate Elements

import java.util.HashSet;

public class Main
{
    public static void main(String[] args)
    {
        HashSet<Integer> s = new HashSet<>();

        s.add(10);
        s.add(20);
        s.add(30);
        s.add(20);
        s.add(10);

        System.out.println("Set Elements: " + s);
        System.out.println("Total Elements: " + s.size());
    }
}
