// LCA 2.8 - Demonstrate Abstract Class

abstract class Shape
{
    abstract void area();
}

class Circle extends Shape
{
    void area()
    {
        int r = 5;
        System.out.println("Area of Circle: " + (3.14 * r * r));
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Circle c = new Circle();
        c.area();
    }
}
