// LCA 2.12 - Interface with Multiple Methods

interface Student
{
    void name();
    void roll();
}

class Demo implements Student
{
    public void name()
    {
        System.out.println("Name: test");
    }

    public void roll()
    {
        System.out.println("Roll No: 1");
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Demo d = new Demo();

        d.name();
        d.roll();
    }
}
