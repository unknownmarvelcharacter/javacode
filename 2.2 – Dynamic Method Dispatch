// Unit 2.2 - Dynamic Method Dispatch

class Parent
{
    void display()
    {
        System.out.println("Parent Class");
    }
}

class Child extends Parent
{
    void display()
    {
        System.out.println("Child Class");
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Parent p;

        p = new Child();
        p.display();
    }
}
