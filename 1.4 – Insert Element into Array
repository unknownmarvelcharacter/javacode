// Unit 1.4 - Insert Element into Array

public class Main
{
    public static void main(String[] args)
    {
        int a[] = {10, 20, 30, 40, 0};
        int n = 4;
        int pos = 2;
        int value = 25;

        for(int i = n; i >= pos; i--)
        {
            a[i] = a[i - 1];
        }

        a[pos - 1] = value;
        n++;

        System.out.println("Updated Array:");

        for(int i = 0; i < n; i++)
        {
            System.out.print(a[i] + " ");
        }
    }
}
