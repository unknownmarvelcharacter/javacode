// LCA 2.3 - Demonstrate this Keyword

class Student
{
    int roll;
    String name;

    Student(int roll, String name)
    {
        this.roll = roll;
        this.name = name;
    }

    void display()
    {
        System.out.println("Roll No: " + roll);
        System.out.println("Name: " + name);
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Student s = new Student(41, "Nishad");
        s.display();
    }
}
