public class Main
{
    public static void main(String[] args)
    {
        Thread t2 = new Thread(() ->
        {
            for(int i = 10; i >= 1; i--)
            {
                System.out.println("Second: " + i);
            }
        });

        Thread t1 = new Thread(() ->
        {
            for(int i = 1; i <= 10; i++)
            {
                System.out.println("First: " + i);

                if(i == 2)
                {
                    t2.start();

                    try
                    {
                        t2.join();
                    }
                    catch(InterruptedException e)
                    {
                        System.out.println(e);
                    }
                }
            }
        });

        t1.start();
    }
}
