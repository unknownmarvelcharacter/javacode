// LCA 4.1 - Count Vowels in a String

public class Main
{
    public static void main(String[] args)
    {
        String s = "Hello Java";
        int count = 0;

        for(int i = 0; i < s.length(); i++)
        {
            char ch = Character.toLowerCase(s.charAt(i));

            if(ch == 'a' || ch == 'e' || ch == 'i' ||
               ch == 'o' || ch == 'u')
            {
                count++;
            }
        }

        System.out.println("Vowels: " + count);
    }
}
