// Unit 1.5 - Delete Element from Array

public class Main
{
    public static void main(String[] args)
    {
        int a[] = {10, 20, 30, 40, 50};
        int n = 5;
        int pos = 3;

        for(int i = pos - 1; i < n - 1; i++)
        {
            a[i] = a[i + 1];
        }

        n--;

        System.out.println("Updated Array:");

        for(int i = 0; i < n; i++)
        {
            System.out.print(a[i] + " ");
        }
    }
}
