// LCA 2.1 - Class and Object

class Student
{
    int roll = 10;
    String name = "Test";

    void display()
    {
        System.out.println("Roll No: " + roll);
        System.out.println("Name: " + name);
    }
}

public class Main
{
    public static void main(String[] args)
    {
        Student s = new Student();
        s.display();
    }
}
